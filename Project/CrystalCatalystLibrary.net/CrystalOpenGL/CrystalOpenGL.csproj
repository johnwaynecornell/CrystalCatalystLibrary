<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>




    <PropertyGroup>
        <MyReferencePath>$(NewAge)\DotNet\Libs\lib\$(Configuration)\$(TargetFramework)</MyReferencePath>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(MyReferencePath)\JWCEssentials.net.dll" />
        <Reference Include="$(MyReferencePath)\AnsiEffectSniffer.dll" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\CrystalCatalystLibrary.net\CrystalCatalystLibrary.net.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="bash NewAge_stage.sh '$(MSBuildProjectName)' '$(MyReferencePath)' '$(OutputPath)/'" />
    </Target>
</Project>
