<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>FacetCLI</AssemblyName>
        <RootNamespace>CrystalCatalyst.Optics.FacetCLI</RootNamespace>
        <MyReferencePath>$(NewAge)\DotNet\Libs\lib\$(Configuration)\$(TargetFramework)</MyReferencePath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CrystalCatalystLibrary.net\CrystalCatalystLibrary.net.csproj" />
        <ProjectReference Include="..\CrystalSkia.net\CrystalSkia.net.csproj" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="bash NewAge_forward.sh '$(MSBuildProjectName)' '$(NewAge)/bin/' '$(OutputPath)/'" />
    </Target>

</Project>
