<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup>
        <MyReferencePath>$(NewAge)\DotNet\Libs\lib\$(Configuration)\$(TargetFramework)</MyReferencePath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="[3.119.2,4.0.0)" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="[3.119.2,4.0.0)" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="[3.119.2,4.0.0)" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="[3.119.2,4.0.0)" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(MyReferencePath)\JWCEssentials.net.dll" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CrystalCatalystLibrary.net\CrystalCatalystLibrary.net.csproj" />
      <ProjectReference Include="..\CrystalOpenGL\CrystalOpenGL.csproj" />
      <ProjectReference Include="..\CrystalSkia.net\CrystalSkia.net.csproj" />
    </ItemGroup>
</Project>