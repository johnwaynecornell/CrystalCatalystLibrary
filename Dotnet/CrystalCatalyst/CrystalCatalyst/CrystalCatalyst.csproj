<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <MyReferencePath>$(NewAge)\DotNet\Libs\lib\$(Configuration)</MyReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MyReferencePath)\NewLib.dll" />
    <Reference Include="$(MyReferencePath)\Lightning.V1.dll" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="NewAge_stage '$(MSBuildProjectName)' '$(MyReferencePath)' '$(OutputPath)'" />
  </Target>
</Project>
