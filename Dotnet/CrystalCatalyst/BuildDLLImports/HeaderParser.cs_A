using System.Diagnostics;
using System.Text;
using Lightning;

namespace BuildDLLImports;

public class HeaderParser
{
    public class Entry
    {
        public string type;
        public QuickList<object> contents = new QuickList<object>();

        public Entry(string type, params object[] contents)
        {
            this.type = type;

            for (int i = 0; i < contents.Length; i++) this.contents.Add(contents[i]);
        }

        public class Cursor
        {
            public Entry E;
            public int position;

            public bool is_end => position >= E.contents.Count;

            public object cur => E.contents[position];
            
            public object take() => E.contents[position++];

            public int remain => E.contents.Count - position;
            public Cursor(Entry E, int position = 0)
            {
                this.E = E;
                this.position = position;

            }
        }

        public Cursor NewCursor(int position = 0) => new Cursor(this, position);
        
        public override string ToString()
        {
            StringBuilder B = new StringBuilder();

            foreach (object o in contents)
            {
                B.Append(o);

            }

            return B.ToString();
        }
    }

    public void Whitespace(string source, ref int position)
    {
        while (position < source.Length && source[position] <= ' ') position++;
    }

    public Entry? _Identifier(string source, ref int position)
    {
        Whitespace(source, ref position);
        if (position == source.Length) return null;

        if (!(source[position] == '_' || char.IsLetter(source[position]))) return null;

        StringBuilder B = new StringBuilder();

        while (position < source.Length && source[position] == '_' || char.IsLetter(source[position]) ||
               char.IsNumber(source[position]))
        {
            B.Append(source[position++]);
        }

        return new Entry("Identifier", B.ToString());
    }

    public Entry? _Quote(string source, ref int position)
    {
        Whitespace(source, ref position);
        if (position == source.Length) return null;

        if (source[position] != '\'' && source[position] != '\"') return null;

        StringBuilder B = new StringBuilder();

        char q = source[position];

        B.Append(q);
        position++;

        bool in_escape = false;

        while (position < source.Length)
        {
            char q2 = source[position];
            B.Append(q2);
            position++;

            if (!in_escape)
            {
                if (q2 == q) return new Entry("Quote", B.ToString());
                if (q2 == '\\') in_escape = true;
            }
            else in_escape = false;
        }

        return null;
    }


    public Entry? _Paren(string source, ref int position)
    {
        Whitespace(source, ref position);
        if (position == source.Length) return null;

        if (source[position] != '(') return null;

        int depth = 1;

        Entry R = new Entry("Paren", '(');
        position++;

        while (position <= source.Length && depth != 0)
        {
            Entry Q = _Quote(source, ref position);

            if (Q != null)
            {
                R.contents.Add(Q);
            }
            else
            {


                if (source[position] != ')')
                {
                    return null;
                }

            }

        }

        return null;
    }

    Entry? consume_paren(Entry.Cursor cursor)
    {
        if (cursor.is_end) return null;

        object o = cursor.cur;

        if (o is char && ((char)o) == '(')
        {
            Entry R = new Entry("Paren", o);
            cursor.position++;

            while (!cursor.is_end)
            {
                o = cursor.cur;
                if (o is char && ((char)o) == ')')
                {
                    R.contents.Add(o);
                    cursor.position++;
                    return R;
                }
                else
                {
                    Entry p2 = consume_paren(cursor);
                    if (p2 != null)
                    {
                        R.contents.Add(p2);
                    }
                    else
                    {
                        R.contents.Add(cursor.take());
                    }
                }
                
            }
            
            Console.Error.WriteLine("ERROR open paren in \""+R+"\"");

        }
        
        return null;
    }
    
    Entry Parenthise(Entry E)
    {
        Entry R = new Entry(E.type);

        Entry.Cursor cursor = E.NewCursor();
        
        while (!cursor.is_end)
        {
            Entry c = consume_paren(cursor);
            if (c != null)
            {
                R.contents.Add(c);
            }
            else
            {
                R.contents.Add(cursor.take());
            }
        }

        return R;
    }

    public Entry? _line(string source, ref int position)
    {
        Whitespace(source, ref position);

        if (position == source.Length) return null;

        Entry R = new Entry("Line");

        //StringBuilder B = new StringBuilder();
        
        while (position < source.Length)
        {
            Entry M;
            
            M = _Identifier(source, ref position);
            if (M == null) M = _Quote(source, ref position);

            if (M != null)
            {
                R.contents.Add(M);
            }
            else
            {
                R.contents.Add(source[position++]);
            }
        }

        R = Parenthise(R);
        return R;
    }

    private string[] directions = new string[] { "P_ELEMENTS", "P_INSTANCE", "P_OUT", "P_IN_OUT" };

    bool is_char(object o, char c)
    {
        if (!(o is char)) return false;
        return ((char)o) == c;
    }
    TypeInfo GetTypeInfo(Entry.Cursor cursor)
    {
        TypeInfo R = new TypeInfo();
        string val;

        val = cursor.take().ToString();

        while (directions.Contains(val))
        {
            R.Directions.Add(val);

            Entry next = (Entry) cursor.take();

            cursor = next.NewCursor(1);
            
            val = cursor.take().ToString();

        }
        
        R.Type = val;

        if (val == "const") R.Type += " " + cursor.take().ToString();
        
        while (cursor.remain >= 2 && is_char(cursor.cur, ':') && is_char(cursor.E.contents[cursor.position+1], ':'))
        {
            cursor.position += 2;

            R.Type += "::" + cursor.take();
        }
        
        
        
        if (!cursor.is_end && cursor.cur.ToString() == "const")
        {
            val = "const " + val;
            cursor.position++;
        }
        
        return R;
    }
    
    ParsedFunction LineToFunction(Entry.Cursor cursor)
    {
        ParsedFunction R = new ParsedFunction();
        R.ReturnType = GetTypeInfo(cursor);
        R.Name = cursor.take().ToString();

        if (!(cursor.cur is Entry))
        {
            Console.Error.Write("ERROR "+cursor.E + " has invalid parameters");
            Debugger.Break();
        }
        
        R.Parameters.AddRange(ParseParameters(cursor.cur as Entry));
        
        return R;
    }
    
    public List<ParsedFunction> ParseHeaderFile(string filePath)
    {
        var functions = new List<ParsedFunction>();
        foreach (var l in File.ReadLines(filePath))
        {
            var trimmedLine = l.Trim();
            
            if (trimmedLine.Length == 0) continue;

            int P;

            for (P = trimmedLine.Length - 1; P >= 0; P--)
            {
                if (trimmedLine[P] == ';') break;
            }
            
            if (P == 0)
            {
                Console.Error.WriteLine("ERROR expected line ending in ';'");
                continue;
            }

            trimmedLine = trimmedLine.Substring(0, P).Trim();
            
            if (trimmedLine.StartsWith("_EXPORT_"))
            {
                int position = "_EXPORT_".Length;
                
                Entry line = _line(trimmedLine, ref position);

                Entry.Cursor c = line.NewCursor();
                functions.Add(LineToFunction(c));
                
            }
            else
            {
                int position = 0;
                Entry line = _line(trimmedLine, ref position);
                Entry.Cursor c = line.NewCursor();
                functions.Add(LineToFunction(c));
            }
        }
        return functions;
    }

    public string entryType(object O)
    {
        if (!(O is Entry)) return "";
        return (O as Entry).type;
    }

    private IEnumerable<Entry> ParenSplit(Entry E)
    {
        if (E.type != "Paren")
        {
            Console.Error.WriteLine("ERROR expevting Paren entry");
        }
        else
        {
            Entry R; 
            R = new Entry("Parameter");
            int i = 1;
            while (i < E.contents.Count - 1)
            {
                if (E.contents[i] is char && ((char)E.contents[i]) == ',')
                {
                    yield return R;
                    R = new Entry("Parameter");
                }
                else R.contents.Add(E.contents[i]);

                i++;
            }
            
            yield return R;
            
        }
    }
    
    private IEnumerable<FunctionParameter> ParseParameters(Entry Params)
    {
        var parameters = new List<FunctionParameter>();
        string s = Params.ToString();
        if (s == "(void)" || s == "()")
        {
            return parameters;
        }

        Console.WriteLine($"Debug: Parsing parameters: '{Params}'");

        foreach (Entry E in ParenSplit(Params))
        {
            if (E.contents.Count > 3 && entryType(E.contents[1]) == "Paren" &&
                ((Entry) E.contents[1]).contents[1].ToString() == "*")
            {
                FunctionParameter R = new FunctionParameter();
                Entry.Cursor c = E.NewCursor();
                
                ParsedFunction F = LineToFunction(c);

                int L = F.Name.Length;
                
                R.Name = F.Name.Substring(2, L-3);
                F.Name = "(*)";
                R.Type = new TypeInfo();
                R.Type.Declaration = F;

                parameters.Add(R);
            }
            else
            {
                FunctionParameter R = new FunctionParameter();
                Entry.Cursor c = E.NewCursor();


                R.Type = GetTypeInfo(c);
                R.Name = c.take().ToString();

                parameters.Add(R);
            }
            
        }
        
        return parameters;
    }
}
