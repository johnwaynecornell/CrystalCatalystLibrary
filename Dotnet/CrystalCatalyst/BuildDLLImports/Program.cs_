namespace BuildDLLImports;

using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions;
using System.Text;

public class FunctionParameter
{
    public List<string> Directions { get; set; } = new List<string>();
    public string Type { get; set; }
    public string Name { get; set; }
}

public class ParsedFunction
{
    public string ReturnType { get; set; }
    public string Name { get; set; }
    public List<FunctionParameter> Parameters { get; set; } = new List<FunctionParameter>();
}

public class HeaderParser
{
    private static Regex functionRegex = new Regex(
        @"_EXPORT_\s+(\w+\s*\*?)\s+(\w+)\((.*?)\)", RegexOptions.Compiled | RegexOptions.Singleline);

    private static Regex callbackRegex = new Regex(
        @"(\w+\s*\*?)\s*\(\*(\w+)\)\((.*?)\)\s*(?:=\s*nullptr)?", RegexOptions.Compiled | RegexOptions.Singleline);
    
    private static Regex parameterWithDirectionRegex = new Regex(
        @"((P_INSTANCE|P_IN_OUT|P_OUT|P_ELEMENTS)\s*\((.*?)\))\s*(\w+)", RegexOptions.Compiled | RegexOptions.Singleline);

    private static Regex parameterWithoutDirectionRegex = new Regex(
        @"([\w\s\*\(\)\[\]:]+)\s+(\w+)", RegexOptions.Compiled | RegexOptions.Singleline);

    public List<ParsedFunction> ParseHeaderFile(string filePath)
    {
        var functions = new List<ParsedFunction>();
        foreach (var line in File.ReadLines(filePath))
        {
            var trimmedLine = line.Trim();
            
            if (trimmedLine.Length == 0) continue;

            if (!trimmedLine.EndsWith(";"))
            {
                Console.Error.WriteLine("ERROR expected line ending in ';'");
                continue;
            }

            trimmedLine = trimmedLine.Substring(0, trimmedLine.Length - 1).Trim();
            
            if (trimmedLine.StartsWith("_EXPORT_"))
            {
                var match = functionRegex.Match(trimmedLine);
                if (match.Success)
                {
                    var parsedFunction = new ParsedFunction
                    {
                        ReturnType = match.Groups[1].Value.Trim(),
                        Name = match.Groups[2].Value.Trim(),
                    };
                    var parameterString = match.Groups[3].Value.Trim();
                    parsedFunction.Parameters.AddRange(ParseParameters(parameterString));
                    functions.Add(parsedFunction);
                }
                else
                {
                    Console.Error.WriteLine("ERROR \""+trimmedLine+"\" not parsed");
                }
            }
            else
            {
                var  match = callbackRegex.Match(trimmedLine);
                if (match.Success)
                {
                    var parsedFunction = new ParsedFunction
                    {
                        ReturnType = match.Groups[1].Value.Trim(),
                        Name = match.Groups[2].Value.Trim(),
                    };
                    var parameterString = match.Groups[3].Value.Trim();
                    parsedFunction.Parameters.AddRange(ParseParameters(parameterString));
                    functions.Add(parsedFunction);
                } else
                {
                    Console.Error.WriteLine("ERROR \""+trimmedLine+"\" not parsed");
                }
            }
        }
        return functions;
    }

    private IEnumerable<FunctionParameter> ParseParameters(string parameterString)
    {
        var parameters = new List<FunctionParameter>();
        if (string.IsNullOrEmpty(parameterString))
        {
            return parameters;
        }

        Console.WriteLine($"Debug: Parsing parameter string: '{parameterString}'");

        var segments = SplitParameters(parameterString);
        foreach (var segment in segments)
        {
            var trimmedSegment = segment.Trim();
            
            var  match = callbackRegex.Match(trimmedSegment);
            if (match.Success)
            {
                var parsedFunction = new ParsedFunction
                {
                    ReturnType = match.Groups[1].Value.Trim(),
                    Name = match.Groups[2].Value.Trim(),
                };
                var parameter = match.Groups[3].Value.Trim();
                parsedFunction.Parameters.AddRange(ParseParameters(parameter));
                
                parameters.Add(new FunctionParameter
                {
                    Directions = new List<string>(),
                    //Type = typeBuilder.ToString().Trim(),
                    //Name = name
                });
                
                //functions.Add(parsedFunction);
                continue;
            }
            
            match = parameterWithDirectionRegex.Match(trimmedSegment);

            if (match.Success)
            {
                Console.WriteLine($"Debug: Found parameter match (with direction): '{match.Value}'");
                var directions = new List<string>();
                var typeBuilder = new StringBuilder();
                var directionBuilder = new StringBuilder();
                
                string[] macros = match.Groups[1].Value.Split(new[] { '(', ')' }, StringSplitOptions.RemoveEmptyEntries);
                for (int i = 0; i < macros.Length - 1; i++)
                {
                    directions.Add(macros[i].Trim());
                    directionBuilder.Append(macros[i].Trim()).Append(" ");
                }
                
                string type = macros[macros.Length - 1].Trim();
                typeBuilder.Append(type);
                
                var name = match.Groups[4].Value.Trim();

                Console.WriteLine($"Debug: Captured direction: '{directionBuilder.ToString().Trim()}'");
                Console.WriteLine($"Debug: Type: '{typeBuilder.ToString().Trim()}', Name: '{name}'");
                parameters.Add(new FunctionParameter
                {
                    Directions = directions,
                    Type = typeBuilder.ToString().Trim(),
                    Name = name
                });
            }
            else
            {
                match = parameterWithoutDirectionRegex.Match(trimmedSegment);

                if (match.Success)
                {
                    Console.WriteLine($"Debug: Found parameter match (without direction): '{match.Value}'");
                    var directions = new List<string>();
                    string type = match.Groups[1].Value.Trim();
                    var name = match.Groups[2].Value.Trim();

                    Console.WriteLine($"Debug: Type: '{type}', Name: '{name}'");
                    parameters.Add(new FunctionParameter
                    {
                        Directions = directions,
                        Type = type,
                        Name = name
                    });
                }
                else
                {
                    // Handle nested function pointers or other complex types recursively
                    var nestedParameters = ParseComplexParameter(trimmedSegment);
                    if (nestedParameters != null)
                    {
                        parameters.AddRange(nestedParameters);
                    }
                }
            }
        }
        return parameters;
    }

    private List<string> SplitParameters(string parameterString)
    {
        var segments = new List<string>();
        int depth = 0;
        var currentSegment = new List<char>();

        foreach (var c in parameterString)
        {
            if (c == ',' && depth == 0)
            {
                segments.Add(new string(currentSegment.ToArray()).Trim());
                currentSegment.Clear();
            }
            else
            {
                if (c == '(' || c == '{' || c == '[')
                {
                    depth++;
                }
                else if (c == ')' || c == '}' || c == ']')
                {
                    depth--;
                }
                currentSegment.Add(c);
            }
        }

        if (currentSegment.Count > 0)
        {
            segments.Add(new string(currentSegment.ToArray()).Trim());
        }

        return segments;
    }

    private IEnumerable<FunctionParameter> ParseComplexParameter(string parameterString)
    {
        var nestedParameters = new List<FunctionParameter>();

        // Check for nested function pointers
        int firstParenthesis = parameterString.IndexOf('(');
        int lastParenthesis = parameterString.LastIndexOf(')');
        if (firstParenthesis != -1 && lastParenthesis != -1 && firstParenthesis < lastParenthesis)
        {
            string beforeParenthesis = parameterString.Substring(0, firstParenthesis).Trim();
            string insideParenthesis = parameterString.Substring(firstParenthesis + 1, lastParenthesis - firstParenthesis - 1).Trim();
            string afterParenthesis = parameterString.Substring(lastParenthesis + 1).Trim();

            var directions = new List<string>();
            if (beforeParenthesis.Contains("(*"))
            {
                int starIndex = beforeParenthesis.IndexOf("(*");
                directions.Add(beforeParenthesis.Substring(0, starIndex).Trim());
                beforeParenthesis = beforeParenthesis.Substring(starIndex + 1).Trim();
            }

            var nestedParam = new FunctionParameter
            {
                Directions = directions,
                Type = $"{beforeParenthesis} (*{ParseParameters(insideParenthesis)})",
                Name = afterParenthesis
            };
            nestedParameters.Add(nestedParam);
        }
        else
        {
            // Handle other complex types
            var parts = parameterString.Split(new[] { ' ' }, 2);
            if (parts.Length == 2)
            {
                nestedParameters.Add(new FunctionParameter
                {
                    Type = parts[0].Trim(),
                    Name = parts[1].Trim()
                });
            }
        }

        return nestedParameters;
    }
}

public class Program
{
    public static void Main(string[] args)
    {
        var headerFilePath = "input.txt"; // Path to your header file
        var parser = new HeaderParser();
        var functions = parser.ParseHeaderFile(headerFilePath);

        foreach (var function in functions)
        {
            Console.WriteLine($"Function: {function.Name}");
            Console.WriteLine($"  Return Type: {function.ReturnType}");
            Console.WriteLine($"  Parameters:");
            foreach (var param in function.Parameters)
            {
                var directionStr = param.Directions.Count > 0 ? $"{string.Join(" ", param.Directions)} " : "";
                Console.WriteLine($"    {directionStr}{param.Type} {param.Name}");
            }
            Console.WriteLine();
        }
    }
}
